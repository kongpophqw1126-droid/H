----------------- ระบบการทำงานภายในสคริปต์ -----------------
local Player = game.Players.LocalPlayer
local Mouse = Player:GetMouse()

-- ระบบปรับความเร็ว (Speed)
SpeedBtn.MouseButton1Click:Connect(function()
    local targetSpeed = tonumber(SpeedInput.Text)
    if targetSpeed then
        -- จำกัดความเร็วให้อยู่ในช่วง 1-100 ตามที่ขอ
        if targetSpeed < 1 then targetSpeed = 1 end
        if targetSpeed > 100 then targetSpeed = 100 end
        SpeedInput.Text = tostring(targetSpeed)
        
        if Player.Character and Player.Character:FindFirstChildOfClass("Humanoid") then
            Player.Character:FindFirstChildOfClass("Humanoid").WalkSpeed = targetSpeed
        end
    end
end)

-- ระบบเดินทะลุ (Noclip)
local noclip = false
NoclipBtn.MouseButton1Click:Connect(function()
    noclip = not noclip
    if noclip then
        NoclipBtn.Text = "เดินทะลุ (Noclip): ON"
        NoclipBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
    else
        NoclipBtn.Text = "เดินทะลุ (Noclip): OFF"
        NoclipBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    end
end)

game:GetService("RunService").Stepped:Connect(function()
    if noclip and Player.Character then
        for _, part in pairs(Player.Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end
end)

-- ระบบบิน (Fly)
local flying = false
local flySpeed = 50
local bv, bg

FlyBtn.MouseButton1Click:Connect(function()
    if not Player.Character or not Player.Character:FindFirstChild("HumanoidRootPart") then return end
    local hrp = Player.Character.HumanoidRootPart
    flying = not flying
    
    if flying then
        FlyBtn.Text = "บิน (Fly): ON"
        FlyBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
        
        bg = Instance.new("BodyGyro", hrp)
        bg.P = 9e4
        bg.maxTorque = Vector3.new(9e9, 9e9, 9e9)
        bg.cframe = hrp.CFrame
        
        bv = Instance.new("BodyVelocity", hrp)
        bv.velocity = Vector3.new(0, 0.1, 0)
        bv.maxForce = Vector3.new(9e9, 9e9, 9e9)
        
        -- ควบคุมการบินด้วยปุ่มเดินทั่วไป (W, A, S, D)
        task.spawn(function()
            local humanoid = Player.Character:FindFirstChildOfClass("Humanoid")
            while flying and task.wait() do
                if humanoid then
                    bv.velocity = humanoid.MoveDirection * flySpeed
                    bg.cframe = workspace.CurrentCamera.CFrame
                end
            end
        end)
    else
        FlyBtn.Text = "บิน (Fly): OFF"
        FlyBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
        if bv then bv:Destroy() end
        if bg then bg:Destroy() end
    end
end)

-- ระบบ GPS (อัปเดตตำแหน่งแบบ Real-time)
game:GetService("RunService").RenderStepped:Connect(function()
    if Player.Character and Player.Character:FindFirstChild("HumanoidRootPart") then
        local pos = Player.Character.HumanoidRootPart.Position
        GPSLabel.Text = string.format("GPS:\nX: %.2f\nY: %.2f\nZ: %.2f", pos.X, pos.Y, pos.Z)
    else
        GPSLabel.Text = "GPS:\nไม่พบตัวละคร"
    end
end)
